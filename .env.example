# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Model provider (any OpenAI-compatible API). For a non-OpenAI provider, set the base URL too
# and set both together, so a key is never sent to the wrong provider.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPS_MODEL=

# Galileo tracing. Leave GALILEO_API_KEY empty to run without tracing.
GALILEO_API_KEY=
GALILEO_PROJECT=
GALILEO_LOG_STREAM=

# Tools
# GITHUB_TOKEN=
# OPS_GITHUB_REPO=himanshu2604/mlops-fraud-pipeline
# OPS_PROMETHEUS_URL=http://localhost:9090
